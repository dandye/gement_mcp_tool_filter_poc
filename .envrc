# ============================================================================
# direnv configuration: per-directory gcloud config, ADC, and uv virtualenv
# ============================================================================

# 1. Automatically create and activate virtualenv using uv (or fallback)
if has uv; then
  VIRTUAL_ENV="${PWD}/.venv"
  if [ ! -d "${VIRTUAL_ENV}" ]; then
    uv venv
  fi
  PATH_add "${VIRTUAL_ENV}/bin"
  export VIRTUAL_ENV
elif [ -d ".venv/bin" ]; then
  PATH_add .venv/bin
  export VIRTUAL_ENV="${PWD}/.venv"
fi

# 2. Load local .env (gitignored). Set GCP_PROJECT_ID and, optionally,
#    GCP_PROJECT_NUMBER, CLOUDSDK_CORE_ACCOUNT, HAIRPIN_MCP_URL,
#    MCP_SERVER_NAME, and REASONING_ENGINE_ID there.
dotenv_if_exists .env

# 3. Isolate gcloud configuration and credentials to this directory.
#    Authenticate once from inside this directory so credentials are stored
#    in ./.gcloud (gitignored):
#      ACCOUNT="user@example.com"
#      gcloud auth login "$ACCOUNT" --update-adc
export CLOUDSDK_CONFIG="${PWD}/.gcloud"

# 4. Target project, region, and SecOps tenant (override in .env)
export GCP_PROJECT_ID="${GCP_PROJECT_ID:-your-gcp-project-id}"
export GCP_LOCATION="${GCP_LOCATION:-us-central1}"
export GCP_STAGING_BUCKET="${GCP_STAGING_BUCKET:-gs://${GCP_PROJECT_ID}-agent-engine-staging}"
export CHRONICLE_CUSTOMER_ID="${CHRONICLE_CUSTOMER_ID:-00000000-0000-0000-0000-000000000000}"
export CHRONICLE_REGION="${CHRONICLE_REGION:-us}"
export MCP_SERVER_NAME="${MCP_SERVER_NAME:-secops-hairpin-mcp}"
export GOOGLE_CLOUD_PROJECT="${GCP_PROJECT_ID}"
export GOOGLE_CLOUD_LOCATION="${GCP_LOCATION}"
export CLOUDSDK_CORE_PROJECT="${GCP_PROJECT_ID}"

# 5. Optional values are exported only when set in .env. When unset, gcloud
#    uses the account activated by `gcloud auth login`, the justfile looks up
#    the project number, and the agent resolves the MCP URL from the
#    registered Gemini Enterprise connector instead of a placeholder.
for OPTIONAL_VAR in GCP_PROJECT_NUMBER CLOUDSDK_CORE_ACCOUNT HAIRPIN_MCP_URL REASONING_ENGINE_ID; do
  if [ -z "${!OPTIONAL_VAR:-}" ]; then
    unset "${OPTIONAL_VAR}"
  fi
done
unset OPTIONAL_VAR

# 6. Application Default Credentials: prefer the isolated copy, otherwise
#    seed it from the user-level ADC file if one exists.
if [ -f "${PWD}/.gcloud/application_default_credentials.json" ]; then
  export GOOGLE_APPLICATION_CREDENTIALS="${PWD}/.gcloud/application_default_credentials.json"
elif [ -f "${HOME}/.config/gcloud/application_default_credentials.json" ]; then
  mkdir -p "${PWD}/.gcloud"
  cp "${HOME}/.config/gcloud/application_default_credentials.json" "${PWD}/.gcloud/application_default_credentials.json"
  export GOOGLE_APPLICATION_CREDENTIALS="${PWD}/.gcloud/application_default_credentials.json"
fi

# 7. Disable client-certificate (mTLS) negotiation so google-auth and gcloud
#    do not invoke a corporate certificate provider on managed workstations.
export GOOGLE_API_USE_CLIENT_CERTIFICATE="false"
export GOOGLE_API_USE_MTLS_ENDPOINT="never"
export CLOUDSDK_CONTEXT_AWARE_USE_CLIENT_CERTIFICATE="false"
export GOOGLE_GENAI_USE_VERTEXAI="TRUE"

# 8. Ignore user- and system-level uv.toml so uv.lock index URLs are
#    authoritative
export UV_NO_CONFIG="1"
