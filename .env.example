# ==============================================================================
# Environment Configuration for Gemini Enterprise Hairpin MCP Proxy
# ==============================================================================

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_LOCATION=us-central1
GCP_STAGING_BUCKET=gs://your-gcp-project-id-agent-engine-staging

# Chronicle / SecOps Tenant
CHRONICLE_CUSTOMER_ID=00000000-0000-0000-0000-000000000000
CHRONICLE_REGION=us
UPSTREAM_ONEMCP_URL=https://us-chronicle.googleapis.com/mcp

# Deployed Hairpin MCP Proxy & Gemini Enterprise Connector
HAIRPIN_MCP_URL=https://secops-hairpin-mcp-123456789012.us-central1.run.app/mcp
MCP_SERVER_NAME=projects/your-gcp-project-id/locations/global/mcpServers/agentregistry-00000000-0000-0000-0000-000000000002
REASONING_ENGINE_ID=projects/123456789012/locations/us-central1/reasoningEngines/9876543210987654321
