# ==============================================================================
# Environment Configuration for Gemini Enterprise Hairpin MCP Proxy
# Copy to .env (gitignored) and fill in the values for your project.
# ==============================================================================

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
# Optional: looked up with `gcloud projects describe` when left empty
GCP_PROJECT_NUMBER=
GCP_LOCATION=us-central1
GCP_STAGING_BUCKET=gs://your-gcp-project-id-agent-engine-staging

# gcloud account for this directory. .envrc isolates gcloud configuration to
# ./.gcloud, so authenticate from inside the repository after `direnv allow .`:
#   gcloud auth login "$CLOUDSDK_CORE_ACCOUNT" --update-adc
# Leave empty to use whichever account `gcloud auth login` activates.
CLOUDSDK_CORE_ACCOUNT=

# Chronicle / SecOps Tenant (used in agent prompts and verification commands)
CHRONICLE_CUSTOMER_ID=00000000-0000-0000-0000-000000000000
CHRONICLE_REGION=us
UPSTREAM_ONEMCP_URL=https://us-chronicle.googleapis.com/mcp

# Deployed Hairpin MCP proxy and Gemini Enterprise connector.
# HAIRPIN_MCP_URL: Cloud Run service URL plus /mcp, set after
#   `just deploy-cloud-run`. When empty, the agent resolves the URL from the
#   registered connector named by MCP_SERVER_NAME.
# MCP_SERVER_NAME: Discovery Engine collection ID created by
#   `just register-connector`, or the synced Agent Registry resource name
#   (projects/<project>/locations/global/mcpServers/agentregistry-<uuid>).
# REASONING_ENGINE_ID: resource name printed by `just deploy-reasoning-engine`.
HAIRPIN_MCP_URL=
MCP_SERVER_NAME=secops-hairpin-mcp
REASONING_ENGINE_ID=
